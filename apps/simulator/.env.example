# All optional — defaults match the original hardcoded pacing. Turn these
# down if a downstream LLM triage provider's rate limit is getting hit
# harder than you want to demonstrate.

# Steady-state delay between single events (seconds).
EVENT_INTERVAL_MIN_SECONDS=1.0
EVENT_INTERVAL_MAX_SECONDS=3.0

# Chance each cycle fires a burst instead of a single event (0-1).
BURST_PROBABILITY=0.15
# How many events land in one burst.
BURST_MIN_SIZE=3
BURST_MAX_SIZE=8
# Delay between events within a burst (seconds) — the most direct knob for
# how many triage requests/minute a burst generates.
BURST_INTERVAL_SECONDS=0.05

# Chance of emitting a deliberately malformed event (missing "type").
INVALID_EVENT_PROBABILITY=0.05
