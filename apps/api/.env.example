DATABASE_URL="postgresql://sentinel:sentinel@localhost:5433/sentinel"
PORT=4000
REDIS_URL="redis://localhost:6379"
SIMULATOR_WS_URL="ws://localhost:8765"
CORS_ORIGIN="http://localhost:3000"

# Optional: triage prefers NVIDIA if set, then OpenRouter, then OpenAI, then
# falls back to a deterministic stub provider so the pipeline still runs
# without any of them.
NVIDIA_API_KEY=
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
# Tried against the same NVIDIA key if the primary model's call fails —
# NVIDIA's shared free endpoint can 503 independent of which model you ask.
NVIDIA_FALLBACK_MODEL="moonshotai/kimi-k3"
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_API_KEY=
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
OPENAI_API_KEY=
TRIAGE_MODEL="gpt-4o-mini"
TRIAGE_TIMEOUT_MS=15000
